<%#
  One work hanging in its hatched frame.
  work: the record
  fig: the figure number shown under it
  edit_modal: dom id of this work's edit modal, when the page carries one
  show_project: label the plate with the project it belongs to
%>
<div class="studio-plate" id="<%= dom_id work %>">
  <div class="frame" style="aspect-ratio:<%= work.aspect_ratio %>">
    <% if work.image.attached? %>
      <%= image_tag work.thumbnail, alt: work.name.to_s, loading: "lazy" %>
    <% else %>
      <span class="studio-tag">no picture</span>
    <% end %>
  </div>

  <div class="caption">
    <span><em><%= work.name %></em><%= ", #{work.year}" if work.year %></span>
    <% if local_assigns[:fig] %>
      <span class="fig">fig. <%= fig %></span>
    <% end %>
    <span class="actions">
      <% if local_assigns[:edit_modal] %>
        <button type="button" class="studio-button small" data-action="studio#open"
                data-studio-modal-param="<%= edit_modal %>">[edit]</button>
        <%= button_to "[remove]", work_path(work), method: :delete, class: "studio-button small quiet",
              form: { data: { turbo_confirm: "Remove “#{work.name}” from #{work.project.name}? The picture goes with it." } } %>
      <% else %>
        <%= link_to "[open]", project_path(work.project), class: "studio-link", style: "font-size:15px" %>
      <% end %>
    </span>
  </div>

  <% if local_assigns[:show_project] %>
    <span class="studio-note"><%= work.project.name %></span>
  <% end %>
</div>
