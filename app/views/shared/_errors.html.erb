<%# record: an ActiveRecord object that may be carrying validation errors %>
<% if record.errors.any? %>
  <div class="studio-errors">
    <p><%= pluralize(record.errors.count, "thing") %> to fix before this can be saved:</p>
    <ul>
      <% record.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
